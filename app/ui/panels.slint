import { Theme, Bridge } from "theme.slint";
import { Store, Prefs, Par } from "store.slint";
import { Btn, Seg, Check, NumField, TextField, FieldRow, Slide, Section, Caption, Hint, Icon, Bullet } from "widgets.slint";

// Карточка шаблона: мини-превью узора и подпись
component TemplateCard inherits Rectangle {
    in property <string> name;
    in property <string> desc;
    in property <string> preview;
    in property <bool> active: false;
    callback clicked();
    min-width: 52px;
    min-height: 44px;
    border-radius: 4px;
    background: root.active ? Theme.acc-soft : Theme.panel;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.acc : Theme.panel-edge;
    VerticalLayout {
        padding: 3px;
        spacing: 1px;
        Rectangle {
            height: 16px;
            clip: true;
            if root.preview == "lines": VerticalLayout {
                for k in 3: Rectangle {
                    height: 2px;
                    width: parent.width - 4px;
                    x: 2px;
                    border-radius: 1px;
                    background: Theme.acc;
                    opacity: 0.8;
                }
            }
            if root.preview != "lines": Rectangle {
                for i in 9: Rectangle {
                    property <int> c: Math.mod(i, 3);
                    property <int> r: Math.floor(i / 3);
                    property <bool> shift: root.preview == "tri" || root.preview == "hex" || root.preview == "rhomb";
                    x: 4px + self.c * 6px + (self.shift && self.r == 1 ? 3px : 0px);
                    y: 1px + self.r * 5px;
                    width: root.preview == "rings" ? 8px - self.r * 1px : 3px;
                    height: root.preview == "rings" ? 8px - self.r * 1px : 3px;
                    border-radius: root.preview == "rings" ? self.width / 2 : 3px;
                    border-width: root.preview == "rings" ? 1px : 0px;
                    border-color: Theme.acc;
                    background: root.preview == "rings" ? transparent : Theme.acc;
                    opacity: 0.85;
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.panel-ink;
                font-family: Theme.mono;
                font-size: Theme.fs-s - 2px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.active: Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.acc;
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Панель библиотеки шаблонов: 6 строк по 3 компактные карточки, прокрутка всем списком
export component TemplatesPanel inherits Flickable {
    content-height: lay.preferred-height + 24px;
    content-width: self.width;
    lay := VerticalLayout {
        width: root.width;
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;
        Text {
            text: @tr("Один клик применяет шаблон — лист, картинка, металл и цены сохраняются.");
            color: Theme.panel-muted;
            font-size: Theme.fs-s;
            wrap: word-wrap;
            min-height: 18px;
        }
        TextField {
            value: Store.template-query;
            placeholder: @tr("Поиск по шаблонам");
            edited(t) => { Store.set-template-query(t); }
        }
        Seg {
            items: [@tr("Все"), @tr("Динамики"), @tr("Вентиляция"), @tr("Декор"), @tr("Лист")];
            current: 0;
            select(i) => {
                Store.set-template-category(i == 0 ? "" : i == 1 ? "dynamic" : i == 2 ? "vent" : i == 3 ? "decor" : "structure");
            }
        }
        for row in Store.template-rows: HorizontalLayout {
            spacing: 6px;
            for t in [row.a, row.b, row.c]: TemplateCard {
                name: t.name;
                desc: t.desc;
                preview: t.preview;
                visible: t.id != "";
                active: t.id != "" && Store.current-template == t.id;
                clicked => { if t.id != "" { Store.apply-template(t.id); } }
            }
        }
    }
}

export component SettingsPanel inherits VerticalLayout {
    Section {
        title: @tr("Изображение");
        if Store.has-image: Rectangle {
            height: (Theme.touch ? 72px : 60px) + (Store.strokes-n > 0 ? 14px : 0px);
            border-radius: 10px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding: 8px;
                padding-right: 4px;
                spacing: 12px;
                Rectangle {
                    width: self.height;
                    border-radius: 6px;
                    clip: true;
                    background: #ffffff;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: Store.thumb;
                        image-fit: cover;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: Store.img-name;
                        color: Theme.t1;
                        font-size: Theme.fs;
                        font-weight: 500;
                        overflow: elide;
                    }
                    Text {
                        text: Store.img-size;
                        color: Theme.t3;
                        font-family: Theme.mono;
                        font-size: Theme.fs-s;
                        overflow: elide;
                    }
                    if Store.strokes-n > 0: Text {
                        text: @tr("штрихов: {}", Store.strokes-n);
                        color: Theme.t3;
                        font-family: Theme.mono;
                        font-size: Theme.fs-s;
                        overflow: elide;
                    }
                }
                // Убрать картинку и сразу рисовать на пустом холсте
                VerticalLayout {
                    alignment: center;
                    Btn {
                        kind: 2;
                        has-icon: true;
                        icon: @image-url("icons/trash.svg");
                        clicked => {
                            Store.image-clear();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        kind: 2;
                        has-icon: true;
                        icon: @image-url("icons/upload.svg");
                        clicked => {
                            Store.open();
                        }
                    }
                }
            }
        }
        if !Store.has-image: HorizontalLayout {
            spacing: 8px;
            Btn {
                text: @tr("Выбрать файл");
                stretch: true;
                has-icon: true;
                icon: @image-url("icons/folder.svg");
                clicked => {
                    Store.open();
                }
            }
            Btn {
                text: @tr("Пример");
                clicked => {
                    Store.sample();
                }
            }
        }
        // Рисунок от руки: на чистом холсте или поверх картинки
        if !Store.has-image: Btn {
            text: @tr("Нарисовать");
            has-icon: true;
            icon: @image-url("icons/brush.svg");
            clicked => {
                Store.draw-open();
            }
        }
        if Store.has-image: HorizontalLayout {
            spacing: 8px;
            Btn {
                text: Store.drawing ? @tr("Готово") : Store.has-sketch ? @tr("Дорисовать") : @tr("Рисовать поверх");
                stretch: true;
                has-icon: true;
                icon: Store.drawing ? @image-url("icons/check.svg") : @image-url("icons/brush.svg");
                clicked => {
                    if Store.drawing {
                        Store.draw-close();
                    } else {
                        Store.draw-open();
                    }
                }
            }
            if Store.has-sketch: Btn {
                text: "SVG";
                has-icon: true;
                icon: @image-url("icons/download.svg");
                clicked => {
                    Store.sketch-svg();
                }
            }
        }
        if Store.has-sketch: Slide {
            label: @tr("Толщина штрихов");
            value: Store.width-k;
            minv: 0.25;
            maxv: 3;
            step: 0.05;
            shown: "× " + Bridge.fmt-n(Store.width-k, 2);
            edited(v) => {
                Store.width-k = v;
                Store.width-changed();
            }
        }
        Seg {
            items: [@tr("Заполнить"), @tr("Вписать"), @tr("Растянуть")];
            current: Store.p.fit == "contain" ? 1 : Store.p.fit == "stretch" ? 2 : 0;
            select(i) => {
                Store.p.fit = i == 1 ? "contain" : i == 2 ? "stretch" : "cover";
                Store.changed();
            }
        }
        FieldRow {
            label: @tr("Масштаб");
            NumField {
                value: Store.p.img-scale;
                scale: 100;
                decimals: 0;
                unit: "%";
                edited(v) => {
                    Store.p.img-scale = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Сдвиг X / Y");
            field-w: Theme.touch ? 220px : 172px;
            NumField {
                value: Store.p.img-dx;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.img-dx = v;
                    Store.changed();
                }
            }
            NumField {
                value: Store.p.img-dy;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.img-dy = v;
                    Store.changed();
                }
            }
        }
        Caption {
            text: @tr("Тон");
        }
        Slide {
            label: @tr("Яркость");
            value: Store.p.brightness;
            minv: -1;
            maxv: 1;
            shown: (Store.p.brightness > 0.004 ? "+" : "") + Bridge.fmt(Store.p.brightness * 100, 0);
            edited(v) => {
                Store.p.brightness = v;
                Store.changed();
            }
        }
        Slide {
            label: @tr("Контраст");
            value: Store.p.contrast;
            minv: -1;
            maxv: 2;
            shown: (Store.p.contrast > 0.004 ? "+" : "") + Bridge.fmt(Store.p.contrast * 100, 0);
            edited(v) => {
                Store.p.contrast = v;
                Store.changed();
            }
        }
        Slide {
            label: @tr("Гамма");
            value: Store.p.gamma;
            minv: 0.2;
            maxv: 3;
            shown: Store.p.gamma.to-fixed(2);
            edited(v) => {
                Store.p.gamma = v;
                Store.changed();
            }
        }
        Slide {
            label: @tr("Порог: светлее — без отверстий");
            value: Store.p.tone-cut;
            minv: 0;
            maxv: 0.9;
            shown: Bridge.fmt(Store.p.tone-cut * 100, 0) + "%";
            edited(v) => {
                Store.p.tone-cut = v;
                Store.changed();
            }
        }
        Caption {
            text: @tr("Крупные отверстия");
        }
        Seg {
            items: [@tr("В тёмных местах"), @tr("В светлых")];
            current: Store.p.negative ? 1 : 0;
            select(i) => {
                Store.p.negative = i == 1;
                Store.changed();
            }
        }
    }

    Section {
        title: @tr("Лист");
        meta: Store.sheet-meta;
        FieldRow {
            label: @tr("Ширина");
            NumField {
                value: Store.p.sheet-w;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.sheet-w = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Высота");
            NumField {
                value: Store.p.sheet-h;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.sheet-h = v;
                    Store.changed();
                }
            }
        }
        Check {
            text: @tr("Сохранять пропорции");
            checked: Store.lock-ratio;
            toggled(b) => {
                Store.lock-ratio = b;
                Store.changed();
            }
        }
        FieldRow {
            label: @tr("Поле без отверстий");
            NumField {
                value: Store.p.border;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.border = v;
                    Store.changed();
                }
            }
        }
        Check {
            text: @tr("Резать наружный контур листа");
            checked: Store.p.outline;
            toggled(b) => {
                Store.p.outline = b;
                Store.changed();
            }
        }
        if Store.p.outline: Caption {
            text: @tr("Недорез рамки (Gap)");
        }
        if Store.p.outline: FieldRow {
            label: @tr("Количество");
            NumField {
                value: Store.p.tab-n;
                integer: true;
                edited(v) => {
                    Store.p.tab-n = Math.clamp(Math.round(v), 0, 9999);
                    Store.changed();
                }
            }
        }
        if Store.p.outline && Store.p.tab-n > 0: FieldRow {
            label: @tr("Шаг, мм");
            NumField {
                value: Store.tab-step;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.set-tab-step(v);
                }
            }
        }
        if Store.p.outline && Store.p.tab-n > 0: FieldRow {
            label: @tr("Ширина");
            NumField {
                value: Store.p.tab-w;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.tab-w = v;
                    Store.changed();
                }
            }
        }
        if Store.p.outline && Store.p.tab-n > 0: Slide {
            label: @tr("Сдвиг по контуру");
            value: Store.p.tab-offset;
            minv: 0;
            maxv: 1;
            step: 0.01;
            shown: Bridge.fmt(Store.p.tab-offset * 100, 0) + "%";
            edited(v) => {
                Store.p.tab-offset = v;
                Store.changed();
            }
        }
        Btn {
            text: @tr("Высота по пропорциям картинки");
            enabled: Store.has-image;
            clicked => {
                Store.aspect();
            }
        }
        FieldRow {
            label: @tr("Мин. перемычка");
            NumField {
                value: Store.p.bridge;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.bridge = v;
                    Store.changed();
                }
            }
        }
    }

    Section {
        title: @tr("Узор");
        Seg {
            items: [@tr("Отверстия"), @tr("Кольца"), @tr("Стиппл"), @tr("Линии")];
            current: Store.p.pattern == "lines" ? 3
                : Store.p.pattern == "stipple" ? 2
                : Store.p.pattern == "rings" ? 1
                : 0;
            select(i) => {
                Store.p.pattern = i == 3 ? "lines"
                    : i == 2 ? "stipple"
                    : i == 1 ? "rings"
                    : "dots";
                Store.changed();
            }
        }
        if Store.p.pattern != "lines": VerticalLayout {
            spacing: Theme.touch ? 7px : 8px;
            if Store.p.pattern == "dots": Caption {
                text: @tr("Сетка");
            }
            if Store.p.pattern == "dots": Seg {
                columns: 4;
                items: [@tr("Квадр."), @tr("Треуг."), @tr("Треуг. 2"), @tr("Прямоуг."),
                        @tr("Косоуг."), @tr("Шест."), @tr("Ромб."), @tr("Радиал."),
                        @tr("Мозаика"), @tr("Адаптив.")];
                current: Store.p.grid == "square" ? 0
                    : Store.p.grid == "tri90" ? 2
                    : Store.p.grid == "rect" ? 3
                    : Store.p.grid == "oblique" ? 4
                    : Store.p.grid == "hex" ? 5
                    : Store.p.grid == "rhomb" ? 6
                    : Store.p.grid == "radial" ? 7
                    : Store.p.grid == "mosaic" ? 8
                    : Store.p.grid == "adaptive" ? 9
                    : 1;
                select(i) => {
                    Store.set-grid(i == 0 ? "square"
                        : i == 2 ? "tri90"
                        : i == 3 ? "rect"
                        : i == 4 ? "oblique"
                        : i == 5 ? "hex"
                        : i == 6 ? "rhomb"
                        : i == 7 ? "radial"
                        : i == 8 ? "mosaic"
                        : i == 9 ? "adaptive"
                        : "tri");
                }
            }
            if Store.p.pattern == "dots" && Store.p.grid == "rect": FieldRow {
                label: @tr("Пропорция Y / X");
                NumField {
                    value: Store.p.grid-aspect;
                    decimals: 2;
                    unit: "×";
                    edited(v) => {
                        Store.p.grid-aspect = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.pattern == "dots" && Store.p.grid == "radial": Hint {
                text: @tr("Точки расставлены концентрическими кольцами от центра листа.");
            }
            if Store.p.pattern == "dots" && Store.p.grid == "adaptive": Hint {
                text: @tr("Сетка с случайным сдвигом: точка пропускается, если соседняя ближе минимальной дистанции.");
            }
            Caption {
                text: @tr("Форма");
            }
            Seg {
                columns: 4;
                items: [@tr("Круг"), @tr("Квадр."), @tr("Ромб"), @tr("Овал"), @tr("Звезда"), @tr("Треуг."), @tr("Шест."), @tr("Прорезь")];
                current: Store.p.shape == "square" ? 1
                    : Store.p.shape == "diamond" ? 2
                    : Store.p.shape == "oval" ? 3
                    : Store.p.shape == "star" ? 4
                    : Store.p.shape == "triangle" ? 5
                    : Store.p.shape == "hex" ? 6
                    : Store.p.shape == "slot" ? 7
                    : 0;
                select(i) => {
                    Store.p.shape = i == 1 ? "square"
                        : i == 2 ? "diamond"
                        : i == 3 ? "oval"
                        : i == 4 ? "star"
                        : i == 5 ? "triangle"
                        : i == 6 ? "hex"
                        : i == 7 ? "slot"
                        : "circle";
                    Store.changed();
                }
            }
            if Store.p.shape == "oval" || Store.p.shape == "triangle": FieldRow {
                label: @tr("Пропорция (высота/ширина)");
                NumField {
                    value: Store.p.shape-aspect;
                    unit: "×";
                    edited(v) => {
                        Store.p.shape-aspect = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.shape == "slot": FieldRow {
                label: @tr("Длина (× ширина)");
                NumField {
                    value: Store.p.shape-aspect;
                    unit: "×";
                    edited(v) => {
                        Store.p.shape-aspect = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.shape == "star": FieldRow {
                label: @tr("Лучей");
                NumField {
                    value: Store.p.star-points;
                    integer: true;
                    unit: @tr("шт");
                    edited(v) => {
                        Store.p.star-points = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.shape == "star": FieldRow {
                label: @tr("Внутр. радиус");
                NumField {
                    value: Store.p.star-inner;
                    unit: "%";
                    edited(v) => {
                        Store.p.star-inner = v;
                        Store.changed();
                    }
                }
            }
            FieldRow {
                label: @tr("Шаг / поворот");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.pitch;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.pitch = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.angle;
                    decimals: 1;
                    unit: "°";
                    edited(v) => {
                        Store.p.angle = v;
                        Store.changed();
                    }
                }
            }
            FieldRow {
                label: @tr("Отверстий по длине");
                NumField {
                    value: Store.holes-n;
                    integer: true;
                    unit: @tr("шт");
                    edited(v) => {
                        Store.set-holes(v);
                    }
                }
            }
            FieldRow {
                label: @tr("Сдвиг X / Y");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.offset-x;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.offset-x = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.offset-y;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.offset-y = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.pattern == "stipple": Hint {
                text: @tr("Отверстия одного размера, расставлены случайно: плотность выше в тёмных местах.");
            }
            Caption {
                text: @tr("Размер");
            }
            if Store.p.size-mode == "dense" || Store.p.pattern == "stipple": FieldRow {
                label: @tr("Размер отверстий");
                NumField {
                    value: Store.p.d-min;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.d-min = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.size-mode != "dense" && Store.p.pattern != "stipple": FieldRow {
                label: @tr("Мин. и макс. размер");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.d-min;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.d-min = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.d-max;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.d-max = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.size-mode != "dense" && Store.p.pattern != "stipple": Btn {
                text: @tr("Макс. размер по шагу и перемычке");
                clicked => {
                    Store.fit-dmax();
                }
            }
            if Store.p.pattern != "stipple": HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Caption {
                        text: @tr("Размер от тона");
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        text: "SVG_t";
                        kind: 2;
                        framed: true;
                        min-height: 30px;
                        clicked => {
                            Store.trace();
                        }
                    }
                }
            }
            if Store.p.pattern == "dots" || Store.p.pattern == "rings": Seg {
                items: [@tr("От мин. до макс."), @tr("Пропорционально"), @tr("По плотности")];
                current: Store.p.size-mode == "prop" ? 1 : Store.p.size-mode == "dense" ? 2 : 0;
                select(i) => {
                    Store.p.size-mode = i == 1 ? "prop" : i == 2 ? "dense" : "range";
                    Store.changed();
                }
            }
            if Store.p.size-mode == "prop" && Store.p.pattern != "stipple": Hint {
                text: @tr("Диаметр растёт от нуля вместе с темнотой, как в SVG tracing. Отверстия меньше мин. размера не режутся.");
            }
            if Store.p.size-mode == "dense": Hint {
                text: @tr("Отверстия одного размера: шаг сжимается в тёмных местах до перемычки, в светлых — полный шаг.");
            }
            if Store.p.size-mode != "dense" && Store.p.pattern != "stipple": FieldRow {
                label: @tr("Шаг размеров");
                NumField {
                    value: Store.p.quant;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.quant = v;
                        Store.changed();
                    }
                }
            }
            Caption {
                text: @tr("Микроджоинты (M-joint)");
            }
            FieldRow {
                label: @tr("Количество");
                NumField {
                    value: Store.p.mjoint-n;
                    integer: true;
                    edited(v) => {
                        Store.p.mjoint-n = Math.clamp(Math.round(v), 0, 24);
                        Store.changed();
                    }
                }
            }
            if Store.p.mjoint-n > 0: FieldRow {
                label: @tr("Шаг, мм");
                NumField {
                    value: Store.mjoint-step;
                    decimals: 2;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.set-mjoint-step(v);
                    }
                }
            }
            if Store.p.mjoint-n > 0: FieldRow {
                label: @tr("Ширина");
                NumField {
                    value: Store.p.mjoint-w;
                    decimals: 2;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.mjoint-w = v;
                        Store.changed();
                    }
                }
            }
            FieldRow {
                label: @tr("Разброс / зерно");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.jitter;
                    unit: "%";
                    edited(v) => {
                        Store.p.jitter = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.seed;
                    integer: true;
                    edited(v) => {
                        Store.p.seed = v;
                        Store.changed();
                    }
                }
            }
            if Store.p.pattern != "lines": FieldRow {
                label: @tr("Целевая перфорация");
                NumField {
                    value: Store.p.target-open;
                    decimals: 0;
                    unit: "%";
                    edited(v) => {
                        Store.p.target-open = Math.clamp(v, 0, 90);
                        Store.changed();
                    }
                }
            }
            if Store.p.pattern != "lines" && Store.p.target-open > 0: Btn {
                text: @tr("Подобрать шаг и размер");
                clicked => { Store.fit-open(); }
            }
            if !(Store.p.pattern == "dots" && Store.p.size-mode == "dense") && Store.p.pattern != "stipple": Check {
                text: @tr("Только заданные размеры");
                checked: Store.p.fixed;
                toggled(b) => {
                    Store.p.fixed = b;
                    Store.changed();
                }
            }
            if Store.p.fixed && !(Store.p.pattern == "dots" && Store.p.size-mode == "dense") && Store.p.pattern != "stipple": TextField {
                value: Store.p.fixed-sizes;
                placeholder: "3, 5, 7, 9";
                mono: true;
                edited(t) => {
                    Store.p.fixed-sizes = t;
                    Store.changed();
                }
            }
        }
        if Store.p.pattern == "lines": VerticalLayout {
            spacing: Theme.touch ? 7px : 8px;
            FieldRow {
                label: @tr("Шаг / поворот");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.line-pitch;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.line-pitch = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.line-angle;
                    decimals: 1;
                    unit: "°";
                    edited(v) => {
                        Store.p.line-angle = v;
                        Store.changed();
                    }
                }
            }
            FieldRow {
                label: @tr("Мин. и макс. ширина");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.w-min;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.w-min = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.w-max;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.w-max = v;
                        Store.changed();
                    }
                }
            }
            Caption {
                text: @tr("Ширина от тона");
            }
            Seg {
                items: [@tr("От мин. до макс."), @tr("Пропорционально")];
                current: Store.p.size-mode == "prop" ? 1 : 0;
                select(i) => {
                    Store.p.size-mode = i == 1 ? "prop" : "range";
                    Store.changed();
                }
            }
            if Store.p.pattern == "lines": Check {
                text: @tr("Синусоида");
                checked: Store.p.wave;
                toggled(b) => {
                    Store.p.wave = b;
                    Store.changed();
                }
            }
            if Store.p.wave && Store.p.pattern == "lines": FieldRow {
                label: @tr("Длина / амплитуда волны");
                field-w: Theme.touch ? 220px : 172px;
                NumField {
                    value: Store.p.wave-len;
                    decimals: 1;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.wave-len = v;
                        Store.changed();
                    }
                }
                NumField {
                    value: Store.p.wave-amp;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.wave-amp = v;
                        Store.changed();
                    }
                }
            }
            FieldRow {
                label: @tr("Шаг выборки");
                NumField {
                    value: Store.p.step;
                    unit: @tr("мм");
                    edited(v) => {
                        Store.p.step = v;
                        Store.changed();
                    }
                }
            }
        }
    }

    Section {
        title: @tr("Металл и лазер");
        meta: Store.metal-meta;
        open: false;
        Caption {
            text: @tr("Материал и цена за кг");
        }
        Seg {
            columns: 3;
            items: ["Сталь 1", "Сталь 2", "Сталь 3", "Нерж. 1,5", "Алюминий", "Оцинковка", "Медь 1", "Своё"];
            current: 7;
            select(i) => {
                if i < 7 {
                    Store.apply-material(i == 0 ? "steel1" : i == 1 ? "steel2" : i == 2 ? "steel3"
                        : i == 3 ? "inox15" : i == 4 ? "aluminium" : i == 5 ? "galvanized" : "copper");
                }
            }
        }
        if Store.preset-names.length > 0: Seg {
            columns: 2;
            items: Store.preset-names;
            current: Store.preset-current;
            select(i) => {
                Store.apply-preset(i);
            }
        }
        HorizontalLayout {
            spacing: 6px;
            TextField {
                value: Store.preset-name;
                placeholder: @tr("Название пресета");
                edited(t) => {
                    Store.preset-name = t;
                }
            }
            Btn {
                text: @tr("Сохранить");
                clicked => {
                    Store.save-preset();
                }
            }
            if Store.preset-current >= 0: Btn {
                text: @tr("Удалить");
                clicked => {
                    Store.delete-preset();
                }
            }
        }
        FieldRow {
            label: @tr("Толщина металла");
            NumField {
                value: Store.p.thickness;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.thickness = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Мин. отверстие, × толщины");
            NumField {
                value: Store.p.min-k;
                unit: "×";
                edited(v) => {
                    Store.p.min-k = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Компенсация реза (kerf)");
            NumField {
                value: Store.p.kerf;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.kerf = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Плотность");
            NumField {
                value: Store.p.density;
                unit: @tr("г/см³");
                edited(v) => {
                    Store.p.density = v;
                    Store.changed();
                }
            }
        }
        Caption {
            text: @tr("Режим резки");
        }
        FieldRow {
            label: @tr("Скорость резки");
            NumField {
                value: Store.p.cut-speed;
                decimals: 0;
                unit: @tr("мм/мин");
                edited(v) => {
                    Store.p.cut-speed = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Холостой ход");
            NumField {
                value: Store.p.rapid-speed;
                decimals: 0;
                unit: @tr("мм/мин");
                edited(v) => {
                    Store.p.rapid-speed = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Время врезки");
            NumField {
                value: Store.p.pierce-time;
                unit: @tr("с");
                edited(v) => {
                    Store.p.pierce-time = v;
                    Store.changed();
                }
            }
        }
    }

    Section {
        title: @tr("Стоимость");
        open: false;
        FieldRow {
            label: @tr("Метр реза");
            NumField {
                value: Store.p.price-m;
                unit: Store.p.currency;
                edited(v) => {
                    Store.p.price-m = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Одна врезка");
            NumField {
                value: Store.p.price-pierce;
                unit: Store.p.currency;
                edited(v) => {
                    Store.p.price-pierce = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Металл, за кг");
            NumField {
                value: Store.p.price-kg;
                unit: Store.p.currency;
                edited(v) => {
                    Store.p.price-kg = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Подготовка заказа");
            NumField {
                value: Store.p.price-fixed;
                unit: Store.p.currency;
                edited(v) => {
                    Store.p.price-fixed = v;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Валюта");
            TextField {
                value: Store.p.currency;
                edited(t) => {
                    Store.p.currency = t;
                    Store.changed();
                }
            }
        }
    }

    Section {
        title: @tr("Монтаж и гравировка");
        open: false;
        FieldRow {
            label: @tr("Монтажных отверстий");
            NumField {
                value: Store.p.mount-n;
                integer: true;
                edited(v) => {
                    Store.p.mount-n = Math.clamp(Math.round(v), 0, 8);
                    Store.changed();
                }
            }
        }
        if Store.p.mount-n > 0: FieldRow {
            label: @tr("Диаметр монтажных");
            NumField {
                value: Store.p.mount-d;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.mount-d = v;
                    Store.changed();
                }
            }
        }
        if Store.p.mount-n > 0: FieldRow {
            label: @tr("Отступ от кромки");
            NumField {
                value: Store.p.mount-inset;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.mount-inset = v;
                    Store.changed();
                }
            }
        }
        Caption {
            text: @tr("Надпись для гравировки");
        }
        TextField {
            value: Store.p.engrave-text;
            placeholder: @tr("Артикул или номер заказа");
            edited(t) => {
                Store.p.engrave-text = t;
                Store.changed();
            }
        }
        if Store.p.engrave-text != "": FieldRow {
            label: @tr("Высота букв");
            NumField {
                value: Store.p.engrave-h;
                decimals: 1;
                unit: @tr("мм");
                edited(v) => {
                    Store.p.engrave-h = v;
                    Store.changed();
                }
            }
        }
        Hint {
            text: @tr("Надпись выгружается в слое ENGRAVE (DXF, SVG) и комментарием в G-code.");
        }
    }

    Section {
        title: "G-code";
        open: false;
        Caption {
            text: @tr("Профиль станка");
        }
        Btn {
            text: @tr("Загрузить профиль JSON");
            clicked => { Store.load-profile(); }
        }
        Seg {
            columns: 2;
            items: ["CypCut", "NCStudio", "GRBL", "LinuxCNC"];
            current: Store.machine-current;
            select(i) => {
                Store.apply-machine(i == 0 ? "cypcut" : i == 1 ? "ncstudio" : i == 2 ? "grbl" : "linuxcnc");
            }
        }
        Caption {
            text: @tr("Команды лазера");
        }
        Seg {
            items: ["M07 / M08", "M03 / M05", @tr("Свои")];
            current: Store.p.gc-on == "M07" && Store.p.gc-off == "M08" ? 0 : Store.p.gc-on == "M03" && Store.p.gc-off == "M05" ? 1 : 2;
            select(i) => {
                if i == 0 {
                    Store.p.gc-on = "M07";
                    Store.p.gc-off = "M08";
                    Store.changed();
                } else if i == 1 {
                    Store.p.gc-on = "M03";
                    Store.p.gc-off = "M05";
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Включить");
            TextField {
                value: Store.p.gc-on;
                mono: true;
                edited(t) => {
                    Store.p.gc-on = t;
                    Store.changed();
                }
            }
        }
        FieldRow {
            label: @tr("Выключить");
            TextField {
                value: Store.p.gc-off;
                mono: true;
                edited(t) => {
                    Store.p.gc-off = t;
                    Store.changed();
                }
            }
        }
        Caption {
            text: @tr("Начало программы");
        }
        TextField {
            multi: true;
            mono: true;
            value: Store.p.gc-header;
            edited(t) => {
                Store.p.gc-header = t;
                Store.changed();
            }
        }
        Caption {
            text: @tr("Конец программы");
        }
        TextField {
            multi: true;
            mono: true;
            value: Store.p.gc-footer;
            edited(t) => {
                Store.p.gc-footer = t;
                Store.changed();
            }
        }
        Caption {
            text: @tr("Ноль координат");
        }
        Seg {
            items: [@tr("Левый низ"), @tr("Центр"), @tr("Левый верх")];
            current: Store.p.origin == "center" ? 1 : Store.p.origin == "tl" ? 2 : 0;
            select(i) => {
                Store.p.origin = i == 1 ? "center" : i == 2 ? "tl" : "bl";
                Store.changed();
            }
        }
        Check {
            text: @tr("Окружности дугами G02");
            checked: Store.p.gc-arcs;
            toggled(b) => {
                Store.p.gc-arcs = b;
                Store.changed();
            }
        }
        Check {
            text: @tr("Номера строк N");
            checked: Store.p.gc-numbers;
            toggled(b) => {
                Store.p.gc-numbers = b;
                Store.changed();
            }
        }
        FieldRow {
            label: @tr("Знаков после точки");
            NumField {
                value: Store.p.gc-decimals;
                integer: true;
                edited(v) => {
                    Store.p.gc-decimals = Math.clamp(Math.round(v), 1, 6);
                    Store.changed();
                }
            }
        }
        Check {
            text: @tr("DXF: слой на каждый размер");
            checked: Store.p.dxf-layers;
            toggled(b) => {
                Store.p.dxf-layers = b;
                Store.changed();
            }
        }
    }

    Section {
        title: @tr("Заказ");
        open: false;
        TextField {
            value: Store.p.name;
            placeholder: @tr("Изделие");
            edited(t) => {
                Store.p.name = t;
                Store.changed();
            }
        }
        TextField {
            value: Store.p.order-no;
            placeholder: @tr("Номер заказа");
            edited(t) => {
                Store.p.order-no = t;
                Store.changed();
            }
        }
        TextField {
            value: Store.p.client;
            placeholder: @tr("Клиент");
            edited(t) => {
                Store.p.client = t;
                Store.changed();
            }
        }
        TextField {
            value: Store.p.phone;
            placeholder: @tr("Телефон");
            kind: InputType.text;
            edited(t) => {
                Store.p.phone = t;
                Store.changed();
            }
        }
        TextField {
            value: Store.p.email;
            placeholder: "E-mail";
            edited(t) => {
                Store.p.email = t;
                Store.changed();
            }
        }
        TextField {
            multi: true;
            value: Store.p.comment;
            placeholder: @tr("Комментарий");
            edited(t) => {
                Store.p.comment = t;
                Store.changed();
            }
        }
        Btn {
            text: @tr("Сбросить настройки");
            kind: 2;
            clicked => {
                Store.reset();
            }
        }
    }
}

component Stat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    border-radius: Theme.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.neon-cyan-soft;
    min-height: lay.preferred-height;
    horizontal-stretch: 1;
    // Свечение верхней кромки — лазерная линия на каждой карточке итога
    Rectangle {
        x: 0; y: -4px;
        width: parent.width;
        height: Theme.panel-bar + 8px;
        background: Theme.glow;
    }
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: Theme.panel-bar;
        background: Theme.acc;
    }
    lay := VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text {
            // Подпись — капс-стиль Inter с трекингом, значение — только моно
            text: root.label;
            color: Theme.panel-muted;
            font-family: Theme.sans;
            font-size: Theme.fs-s;
            font-weight: 600;
            letter-spacing: 0.8px;
            overflow: elide;
        }
        Text {
            text: root.value;
            color: Theme.acc-text;
            font-family: Theme.mono;
            font-size: Theme.fs-h + 3px;
            font-weight: 700;
            overflow: elide;
        }
    }
}

component Head inherits Text {
    color: Theme.panel-muted;
    font-family: Theme.mono;
    font-size: Theme.fs-s + 1px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

export component SummaryPanel inherits VerticalLayout {
    padding: Theme.touch ? 12px : 16px;
    spacing: Theme.touch ? 12px : 16px;
    VerticalLayout {
        spacing: 4px;
        Head {
            text: @tr("Стоимость резки");
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: Store.stats.has ? Store.stats.cost : "—";
                color: Theme.acc-text;
                font-family: Theme.mono;
                font-size: Theme.fs-xl;
            }
            if Store.stats.has: VerticalLayout {
                alignment: end;
                padding-bottom: 4px;
                Text {
                    text: Store.stats.currency;
                    color: Theme.t3;
                    font-size: Theme.fs;
                }
            }
        }
        for kv in Store.stats.rows: HorizontalLayout {
            Text {
                text: kv.k;
                color: Theme.t2;
                font-size: Theme.fs-s + 1px;
                horizontal-stretch: 1;
            }
            Text {
                text: kv.v;
                color: Theme.t1;
                font-family: Theme.mono;
                font-size: Theme.fs-s;
            }
        }
    }
    GridLayout {
        spacing: 8px;
        Row {
            Stat {
                label: @tr("Контуров");
                value: Store.stats.has ? Store.stats.count : "—";
            }
            Stat {
                label: @tr("Врезок");
                value: Store.stats.has ? Store.stats.pierces : "—";
            }
        }
        Row {
            Stat {
                label: @tr("Длина реза");
                value: Store.stats.has ? Store.stats.cut : "—";
            }
            Stat {
                label: @tr("Время");
                value: Store.stats.has ? Store.stats.time : "—";
            }
        }
        Row {
            Stat {
                label: @tr("Перфорация");
                value: Store.stats.has ? Store.stats.open : "—";
            }
            Stat {
                label: @tr("Масса листа");
                value: Store.stats.has ? Store.stats.mass : "—";
            }
        }
    }
    if Store.stats.sizes.length > 0: VerticalLayout {
        spacing: 6px;
        Head {
            text: @tr("Отверстия по размерам");
        }
        for s in Store.stats.sizes: HorizontalLayout {
            spacing: 10px;
            height: Theme.touch ? 24px : 20px;
            Text {
                width: Theme.touch ? 64px : 56px;
                text: s.label;
                color: Theme.t2;
                font-family: Theme.mono;
                font-size: Theme.fs-s;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    x: 0;
                    width: Math.max(2px, parent.width * s.frac);
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.bar;
                }
            }
            Text {
                width: 48px;
                text: s.n;
                color: Theme.t1;
                font-family: Theme.mono;
                font-size: Theme.fs-s;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        if Store.stats.sizes-note != "": Hint {
            text: Store.stats.sizes-note;
        }
    }
    VerticalLayout {
        spacing: 8px;
        Head {
            text: @tr("Проверка под лазер");
        }
        if Store.stats.warnings.length == 0: Bullet {
            text: Store.stats.ok-line;
            dot: Theme.ok;
            ink: Theme.t2;
        }
        for w in Store.stats.warnings: Bullet {
            text: w;
            dot: Theme.warn;
        }
    }
}

export component ExportPanel inherits VerticalLayout {
    padding: Theme.touch ? 12px : 16px;
    spacing: Theme.touch ? 6px : 8px;
    Head {
        text: @tr("Недавние заказы");
    }
    if Store.recent-orders.length > 0: VerticalLayout {
        for name in Store.recent-orders: Btn {
            text: name;
            clicked => { Store.open-recent(name); }
        }
    }
    if Store.recent-orders.length == 0: Hint {
        text: @tr("Откройте файл .perfo — он появится здесь.");
    }
    Head {
        text: @tr("Слои экспорта");
    }
    Check {
        text: "CONTOUR · " + @tr("контур листа");
        checked: Store.p.layer-contour;
        toggled(b) => { Store.p.layer-contour = b; Store.changed(); }
    }
    Check {
        text: "HOLES · " + @tr("отверстия узора");
        checked: Store.p.layer-holes;
        toggled(b) => { Store.p.layer-holes = b; Store.changed(); }
    }
    Check {
        text: "MOUNT · " + @tr("монтажные отверстия");
        checked: Store.p.layer-mount;
        toggled(b) => { Store.p.layer-mount = b; Store.changed(); }
    }
    Check {
        text: "ENGRAVE · " + @tr("гравировка");
        checked: Store.p.layer-engrave;
        toggled(b) => { Store.p.layer-engrave = b; Store.changed(); }
    }
    Head {
        text: @tr("Форматы");
    }
    Btn {
        text: @tr("Пакетная обработка папки");
        clicked => { Store.batch(); }
    }
    for f[i] in Store.formats: Rectangle {
        min-height: Theme.touch ? 60px : 48px;
        border-radius: 6px;
        background: ta.has-hover ? Theme.panel-edge : Theme.panel;
        border-width: 1px;
        border-color: Theme.panel-edge;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Bridge.haptic("tick");
                Store.format-toggled(i, !f.on);
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Theme.touch ? 22px : 16px;
                    height: self.width;
                    border-radius: 4px;
                    background: f.on ? Theme.acc : Theme.panel-edge;
                    border-width: f.on ? 0px : 1px;
                    border-color: Theme.panel-edge;
                    if f.on: Image {
                        width: parent.width - 2px;
                        height: self.width;
                        source: @image-url("icons/check.svg");
                        colorize: Theme.acc-ink;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 1px;
                Text {
                    text: f.title;
                    color: Theme.panel-ink;
                    font-size: Theme.fs;
                    font-weight: 500;
                }
                Text {
                    text: f.note;
                    color: Theme.panel-muted;
                    font-size: Theme.fs-s;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    kind: 2;
                    has-icon: true;
                    icon: @image-url("icons/download.svg");
                    enabled: Store.can-export;
                    clicked => {
                        Store.export-one(i);
                    }
                }
            }
        }
    }
    Rectangle {
        height: 8px;
    }
    Btn {
        kind: 1;
        text: @tr("Скачать выбранные, ZIP");
        has-icon: true;
        icon: @image-url("icons/download.svg");
        enabled: Store.can-export;
        clicked => {
            Store.export-zip();
        }
    }
    Btn {
        text: @tr("Сохранить заказ .perfo");
        has-icon: true;
        icon: @image-url("icons/save.svg");
        enabled: Store.has-image;
        clicked => {
            Store.save-order();
        }
    }
}
