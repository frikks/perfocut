// Цвета, размеры и шрифты интерфейса. Все компоненты берут значения только отсюда.
export global Theme {
    // 0 HUD, 1 Blueprint, 2 Терминал, 3 Осциллограф, 4 Промышленная, 5 AMOLED
    in-out property <int> mode: 0;
    // Акцентный цвет: 0 цитрус, 1 изумруд, 2 лазурь, 3 аметист, 4 роза, 5 магма
    in-out property <int> accent: 0;
    // Сенсорный экран: крупнее строки и шрифт
    in-out property <bool> touch: false;
    // Системный масштаб шрифта Android
    in-out property <float> font-scale: 1.0;

    out property <bool> dark: true;
    out property <bool> amoled: mode == 5;

    // Палитры техно-тем: каждая задаёт фон, панели и сетку; акцент задаётся отдельно
    out property <color> bg0: mode == 0 ? #01070a : mode == 1 ? #06182a : mode == 2 ? #000000
        : mode == 3 ? #080a0c : mode == 4 ? #15181a : #000000;
    out property <color> bg: mode == 0 ? #020b0e : mode == 1 ? #071e33 : mode == 2 ? #000000
        : mode == 3 ? #0a0e11 : mode == 4 ? #1a1c1e : #000000;
    out property <color> card: mode == 0 ? #04191f : mode == 1 ? #08253e : mode == 2 ? #010703
        : mode == 3 ? #0d1618 : mode == 4 ? #181a1c : #0b0b0c;
    out property <color> raised: mode == 0 ? #041419 : mode == 1 ? #08253e : mode == 2 ? #020b04
        : mode == 3 ? #0d1316 : mode == 4 ? #232629 : #141415;
    out property <color> raised2: mode == 0 ? #0a2c33 : mode == 1 ? #0d3555 : mode == 2 ? #063018
        : mode == 3 ? #14231c : mode == 4 ? #2e3235 : #1d1d1f;
    out property <color> line: #ffffff14;
    out property <color> line2: #ffffff24;
    out property <color> field-line: amoled ? #ffffff4d : #ffffff42;
    out property <color> field-hover: #ffffff6b;
    out property <color> t1: #ededed;
    out property <color> t2: #a1a1a6;
    out property <color> t3: #85858b;
    // Акцент: цитрус, изумруд, лазурь, аметист, роза, магма
    out property <color> acc: accent == 1 ? #2fbf8f
        : accent == 2 ? #4aa8ff
        : accent == 3 ? #9d7bff
        : accent == 4 ? #ef5f96
        : accent == 5 ? #ef5350
        : #e8833a;
    out property <color> acc-hover: !dark ? (accent == 1 ? #27a87e
        : accent == 2 ? #3591f0
        : accent == 3 ? #8658f0
        : accent == 4 ? #e14a86
        : accent == 5 ? #e03e38
        : #dc7429)
        : (accent == 1 ? #46d3a2
        : accent == 2 ? #66b8ff
        : accent == 3 ? #ae92ff
        : accent == 4 ? #f97ab0
        : accent == 5 ? #ff6b66
        : #ef9150);
    out property <color> acc-ink: accent == 1 ? #082018
        : accent == 2 ? #0a1a2b
        : accent == 3 ? #180f2b
        : accent == 4 ? #2b0a16
        : accent == 5 ? #2b0d0a
        : #1b1209;
    out property <color> acc-text: !dark ? (accent == 1 ? #17835c
        : accent == 2 ? #1d6fc4
        : accent == 3 ? #6f3fd6
        : accent == 4 ? #c93a74
        : accent == 5 ? #b3322c
        : #b45a17)
        : (accent == 1 ? #6fdcb4
        : accent == 2 ? #85bcff
        : accent == 3 ? #bda2ff
        : accent == 4 ? #fa92bd
        : accent == 5 ? #ff8079
        : #f0a36b);
    // Семантические токены: фокус, мягкий акцент, поверхность наведения, радиус и сетка отступов
    out property <color> focus: acc;
    out property <color> acc-soft: acc.with-alpha(0.14);
    out property <color> hover-surface: dark ? #ffffff0f : #0000000a;
    out property <length> radius: 10px;
    out property <length> gap: 8px;
    // Стеклянная консоль: полупрозрачные слои, кромки, тени и мягкое свечение
    out property <color> glass: dark ? #ffffff0a : #ffffffb8;
    out property <color> glass-strong: dark ? #1c1c20e6 : #fffffff5;
    out property <color> glass-edge: dark ? #ffffff1f : #00000024;
    out property <color> glass-shine: dark ? #ffffff12 : #ffffff66;
    out property <color> glass-shadow: dark ? #00000080 : #18181b26;
    out property <color> glow: acc.with-alpha(0.20);
    out property <length> radius-lg: 16px;
    // Оболочка и панели каждой техно-темы; акцент окрашивает кромки и активные состояния
    out property <color> shell: bg0;
    out property <color> shell-raised: bg;
    out property <color> panel: card;
    out property <color> panel-edge: mode == 0 ? #164a55 : mode == 1 ? #2f6d99 : mode == 2 ? #1f8a4c
        : mode == 3 ? #2c4a3c : mode == 4 ? #3c4145 : #333338;
    out property <color> panel-ink: #ededed;
    out property <color> panel-muted: #a1a1a6;
    out property <color> shell-ink: #ededed;
    out property <color> grid-line: mode == 0 ? #0c3b45 : mode == 1 ? #1a4a70 : mode == 2 ? #0b3a1f
        : mode == 3 ? #1c382b : mode == 4 ? #1d2123 : #ffffff12;
    out property <length> panel-bar: 3px;
    out property <color> seg-on: !dark ? #ffffff : amoled ? #2a2a2d : #38383c;
    out property <color> bar: !dark ? #c7c7cc : amoled ? #3d3d42 : #4a4a4f;
    out property <color> toast: !dark ? #18181b : amoled ? #1d1d1f : #2c2c2f;
    out property <color> toast-text: !dark ? #fafafa : #ededed;
    out property <color> dim: dark ? #ededed47 : #18181b59;
    out property <color> scrim: !dark ? #18181b6b : amoled ? #000000b8 : #00000099;
    out property <color> warn: dark ? #d9a441 : #b7791f;
    out property <color> ok: dark ? #4cc38a : #2f9e6b;

    out property <length> row: touch ? Math.max(34px, fs * 2.1) : 32px;
    // Поля ввода ниже обычных строк: больше настроек помещается без прокрутки
    out property <length> field-row: touch ? Math.max(32px, fs * 1.95) : 28px;
    out property <length> fs: 14px * font-scale;
    out property <length> fs-s: 12px * font-scale;
    out property <length> fs-m: 13px * font-scale;
    out property <length> fs-h: 15px * font-scale;
    out property <length> fs-xl: (touch ? 30px : 28px) * font-scale;
    out property <length> icon: touch ? 15px : 16px;
    out property <length> pad: touch ? 12px : 16px;
    out property <string> sans: "Inter";
    out property <string> mono: "JetBrains Mono";
}

// Общение интерфейса с программой на Rust
export global Bridge {
    // Отклик вибрацией: "click" для кнопок, "tick" для переключателей
    callback haptic(string);
    // Число для поля ввода: без лишних нулей, точка как разделитель
    pure callback fmt(float, int) -> string;
    // Число для подписи: запятая по-русски, без лишних нулей
    pure callback fmt-n(float, int) -> string;
    pure callback num-ok(string) -> bool;
    pure callback num(string) -> float;
}

// Поле ввода в фокусе: где оно, чтобы поставить его по центру над клавиатурой
export global Kb {
    in-out property <bool> text-focused;
    in-out property <length> focus-y;
    in-out property <length> focus-h;
    in-out property <int> seq;
}
